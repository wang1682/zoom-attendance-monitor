+      ol.innerHTML=allParticipants.map(p=>`<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--div)"><span style="width:8px;height:8px;border-radius:50%;background:var(--sc);flex-shrink:0"></span><span style="flex:1;font-size:13px;font-weight:500">${p.name}</span><span style="font-size:12px;color:var(--ts)">${p.online_display||""}</span></div>`).join("");
+    } else {
+      ol.innerHTML='<div style="text-align:center;padding:20px;color:var(--tm)">暂无在线</div>';
+    }
+
+    // Sharing
