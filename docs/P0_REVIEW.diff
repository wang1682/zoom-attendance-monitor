+    } else {
+      ol.innerHTML='<div style="text-align:center;padding:20px;color:var(--tm)">暂无在线</div>';
+    }
+
+    // Participants table
+    const sd=d.participants_summary||[];
+    document.getElementById("sc").textContent=sd.length+"人";
+    const sb=document.getElementById("sb");
+    if(sd.length){
+      sb.innerHTML=sd.slice(0,8).map((p,i)=>'<tr><td class="i">'+(i+1)+'</td><td class="nm">'+p.name+'</td><td>'+(p.total_actions||(p.enters+p.leaves))+'</td><td>'+p.duration_display+'</td><td>'+(p.flags?.length?p.flags.map(f=>'<span class="tg tg-d">'+f+'</span>').join(""):'<span style="color:var(--tm)">—</span>')+'</td><td><span style="width:8px;height:8px;border-radius:50%;display:inline-block;background:'+(p.is_online?"var(--sc)":"var(--tm)")+'\"></span></td><td class="mono">'+((p.last_active||"").slice(11,19))+'</td></tr>').join("");
+    } else {
+      sb.innerHTML='<tr><td colspan="7" style="text-align:center;padding:32px;color:var(--tm)">暂无</td></tr>';
+    }
+
+    // Recent events
+    const ev=sd.filter(p=>p.last_active).sort((a,b)=>(b.last_active||"").localeCompare(a.last_active||"")).slice(0,10);
