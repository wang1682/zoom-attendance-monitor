+def to_myt(dt_str):
+    """将 UTC 时间字符串转为北京时间显示"""
+    if not dt_str:
+        return ""
+    try:
+        s = dt_str.replace("Z", "+00:00")
+        dt = datetime.fromisoformat(s)
+        return dt.astimezone(MYT).strftime("%m-%d %H:%M:%S")
+    except:
+        return dt_str[:16]
