+        """, (start_str,)).fetchall()
+        cols = ["name", "meeting_id", "action", "action_time", "email"]
+
+        from collections import defaultdict
+        user_stats = defaultdict(lambda: {"days": set(), "total_entries": 0, "total_duration": 0, "meetings": set(), "email": ""})
+
+        # 先把记录按人分组，配对 enter/leave
+        for r in rows:
+            d = dict(zip(cols, r))
