+        # 用 code 换 token
+        import requests
+        r = requests.post("https://zoom.us/oauth/token", data={
+            "grant_type": "authorization_code",
+            "code": code,
+            "redirect_uri": REDIRECT_URI,
+            "client_id": ZOOM_CLIENT_ID,
+            "client_secret": ZOOM_CLIENT_SECRET,
+        }, timeout=10)
+        d = r.json()
