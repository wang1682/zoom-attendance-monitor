+        } else if(sd.current>0){
+          sl.innerHTML='<div style="text-align:center;padding:20px;color:var(--wa)">已检测到 '+sd.current+' 人共享，但暂无明细</div>';
+        } else {
+          sl.innerHTML='<div style="text-align:center;padding:20px;color:var(--tm)">当前无人共享</div>';
+        }
+      }
+    }catch(e){}
+
+    // Anomaly (from v2)
+    try{
+      const a2=await fetch("/api/v2/live");
+      const ad2=await a2.json();
+      if(ad2.ok){
+        const anoms=ad2.anomalies||[];
+        document.getElementById("at").textContent=anoms.length+"人";
+        const al=document.getElementById("al");
+        if(anoms.length){
+          al.innerHTML=anoms.slice(0,3).map((a,i)=>'<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--div)"><span style="width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;background:'+(i===0?'var(--da-b);color:var(--da)':i===1?'var(--wa-b);color:var(--wa)':'var(--in-b);color:var(--in)')+'">'+(i+1)+'</span><div style="flex:1"><div style="font-size:13px;font-weight:600">'+a.name+'</div><div style="font-size:11px;color:var(--ts)">'+a.flags.join("、")+'</div></div><div style="font-size:14px;font-weight:600;color:var(--ts)">'+a.actions+'次</div></div>').join("");
+        } else {
+          al.innerHTML='<div style="text-align:center;padding:24px;color:var(--tm)">✅ 今日无异常</div>';
+        }
+
+      }
+    }catch(e){}
+    // Participants — independent from v2, ded try/catch
+    try {
+      var v3ps2 = (window.v3data && (window.v3data.participants_summary || (window.v3data.data && window.v3data.data.participants_summary) || [])) || [];
