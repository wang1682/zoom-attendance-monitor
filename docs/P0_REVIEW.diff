+        today_myt = now_myt.strftime("%Y-%m-%d")
+        # MYT 零点对应的 UTC 时间
+        today_start_myt = datetime.strptime(today_myt, "%Y-%m-%d").replace(tzinfo=MYT)
+        today_start_utc = today_start_myt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
+        cutoff_myt = now_myt - timedelta(minutes=15)
+        today = today_start_utc
+        cutoff_utc_str = (cutoff_myt.astimezone(timezone.utc)).strftime("%Y-%m-%dT%H:%M:%S")
+
+        # 找所有今天有 enter 但没有对应 leave 的记录（即还在线上）
+        rows = conn.execute("""
+            SELECT p1.* FROM zoom_participants p1
