+    @app.get("/api/v2/breakout-live")
+    async def api_breakout_live():
+        """Breakout room 实时分组：从 zoom_events payload 解析"""
+        import json
+        from collections import defaultdict
+        MYT = timezone(timedelta(hours=8))
+        now_utc = datetime.now(timezone.utc)
+        today_myt = datetime.now(MYT).strftime("%Y-%m-%d")
+        today_start_myt = datetime.strptime(today_myt, "%Y-%m-%d").replace(tzinfo=MYT)
+        today_start_utc = today_start_myt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
+
+        conn = db._get_conn()
+        rows = conn.execute("""
+            SELECT id,event_type,payload,created_at
+            FROM zoom_events
+            WHERE created_at >= datetime('now','-2 hours')
+            ORDER BY id ASC
+        """).fetchall()
+
+        people = {}
+        groups = defaultdict(dict)
+
+        def get_time(obj, participant, created_at):
+            return (
+                participant.get("join_time")
+                or participant.get("leave_time")
+                or participant.get("date_time")
+                or participant.get("sharing_details", {}).get("date_time")
+                or created_at
+            )
+
+        for eid, event_type, payload, created_at in rows:
+            try:
+                j = json.loads(payload)
+            except Exception:
+                continue
+
+            obj = j.get("payload", {}).get("object", {}) or {}
+            participant = obj.get("participant", {}) or {}
+
+            name = participant.get("user_name") or participant.get("name") or ""
+            if not name:
+                continue
+
+            meeting_id = str(obj.get("id") or obj.get("meeting_id") or "")
+            room = obj.get("breakout_room_uuid") or "main"
+            participant_uuid = participant.get("participant_uuid") or participant.get("user_id") or name
+            key = f"{meeting_id}:{participant_uuid}:{name}"
+            t = get_time(obj, participant, created_at)
+
+            if key not in people:
+                people[key] = {
+                    "name": name,
+                    "meeting_id": meeting_id,
+                    "participant_uuid": participant_uuid,
+                    "room": "main",
+                    "room_label": "主会场",
+                    "online": False,
+                    "last_event": event_type,
+                    "last_time": t,
+                    "events": 0,
+                }
+
+            pinfo = people[key]
+            pinfo["events"] += 1
+            pinfo["last_event"] = event_type
+            pinfo["last_time"] = t
+
+            leave_reason = (participant.get("leave_reason") or "").lower()
+
+            if event_type == "meeting.participant_joined":
+                pinfo["online"] = True
+                pinfo["room"] = "main"
+                pinfo["room_label"] = "主会场"
+
+            elif event_type == "meeting.participant_left":
+                if "breakout room" in leave_reason:
+                    # 从主会场切到分组，不是真离线
+                    pinfo["online"] = True
+                else:
+                    pinfo["online"] = False
+
+            elif event_type == "meeting.participant_joined_breakout_room":
+                pinfo["online"] = True
+                pinfo["room"] = room
+                pinfo["room_label"] = f"分组 {room[:6]}"
+
+            elif event_type == "meeting.participant_left_breakout_room":
+                # 离开分组，先回主会场；如果后面有真正 left 会再改成离线
+                pinfo["online"] = True
+                pinfo["room"] = "main"
+                pinfo["room_label"] = "主会场"
+
+        online_people = [v for v in people.values() if v["online"]]
+
+        # 用 name 去重，避免同人多 device/重复 webhook；保留最后时间
+        dedup = {}
+        for pinfo in online_people:
+            name = pinfo["name"]
+            if name not in dedup or str(pinfo["last_time"]) > str(dedup[name]["last_time"]):
+                dedup[name] = pinfo
+        online_people = list(dedup.values())
+
+        group_map = defaultdict(list)
+        for pinfo in online_people:
+            group_map[pinfo["room"]].append({
+                "name": pinfo["name"],
+                "meeting_id": pinfo["meeting_id"],
+                "participant_uuid": pinfo["participant_uuid"],
+                "last_time": pinfo["last_time"],
+                "last_event": pinfo["last_event"],
+            })
+
+        groups_out = []
+        for room, members in group_map.items():
+            label = "主会场" if room == "main" else f"分组 {room[:6]}"
+            groups_out.append({
+                "room": room,
+                "label": label,
+                "count": len(members),
+                "members": sorted(members, key=lambda x: x["name"].lower())
+            })
+
+        groups_out.sort(key=lambda g: (g["room"] == "main", g["label"]))
+
+        return {
+            "ok": True,
+            "total_online": len(online_people),
+            "groups": groups_out,
+            "online": sorted(online_people, key=lambda x: x["name"].lower()),
+        }
