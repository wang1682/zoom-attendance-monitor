+    } else {
+      eb.innerHTML='<tr><td colspan="4" style="text-align:center;padding:32px;color:var(--tm)">暂无</td></tr>';
+    }
+  } catch(e){}
+}
+ld();
+setInterval(ld,15000);
+</script>
+{% endblock %}
