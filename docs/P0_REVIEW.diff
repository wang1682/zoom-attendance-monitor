+    document.getElementById("hParticipants").textContent=allParticipants.length;
+    document.getElementById("hRisk").textContent="—";
+    document.getElementById("hEvents").textContent=allParticipants.length;
+
+    // AI Hero (from v2 live for ai_summary)
