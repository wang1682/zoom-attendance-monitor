+
+    # ── 看板 ─────────────────────────────────────────────────────────────────
+    @app.get("/", response_class=RedirectResponse)
+    async def landing(request: Request):
+        """Landing Page — 重定向到数据看板"""
+        return RedirectResponse(url="/dashboard")
+
+    @app.get("/dashboard", response_class=HTMLResponse)
