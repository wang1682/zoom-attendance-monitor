+    async def auth_login(request: Request):
+        """生成 Zoom OAuth 授权链接，支持 Web 和 Mobile（Zoom App）两种方式"""
+        state = secrets.token_urlsafe(16)
+        conn = db._get_conn()
+        conn.execute("INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)", ("oauth_state", state))
+        conn.commit()
