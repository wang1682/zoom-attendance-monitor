+        }
+        if(ad.anomalies?.length){
+          ad.anomalies.slice(0,2).forEach(a=>{
+            html+=`<div class="aih-item"><span class="aih-dot" style="background:var(--da)"></span><div class="aih-text"><span class="aih-highlight">⚠ ${a.name}：</span>${a.flags.join("、")}</div></div>`;
+          });
+        }
+        const sumPs=ps.filter(s=>s.includes("建议")||s.includes("关注")||s.includes("正常"));
+        if(sumPs.length){
+          html+=`<div class="aih-item"><span class="aih-dot" style="background:var(--sc)"></span><div class="aih-text">💡 ${sumPs[0]}</div></div>`;
+        }
+        aiDiv.innerHTML=html||`<div class="aih-item"><div class="aih-text" style="color:var(--tm)">暂无足够数据生成分析</div></div>`;
+      }
+    }catch(e){}
+
+    // Online list (from v3 — real data)
+    document.getElementById("oc").textContent=totalOnline+"人";
+    const ol=document.getElementById("ol");
