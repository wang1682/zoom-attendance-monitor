# =============================================================================
# Zoom 参会监控 — 环境变量配置
# =============================================================================

# ── Zoom API (Server-to-Server OAuth) ────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=
ZOOM_PMI_ID=
ZOOM_EXTRA_MEETING_IDS=

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIVATE_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_GROUP_ENABLED=false

# ── Zoom Webhook ─────────────────────────────────────────────────────────────
ZOOM_WEBHOOK_SECRET=

# ── 时段控制 ────────────────────────────────────────────────────────────────
PUSH_START_HOUR=7
PUSH_END_HOUR=23
SIGNIN_DEADLINE_HOUR=9
SUMMARY_HOURS=16,23
DAILY_REPORT_HOUR=23
OVERTIME_MINUTES=120

# ── 数据库 ───────────────────────────────────────────────────────────────────
# Docker: 使用 volume 挂载路径
DATABASE_URL=sqlite+aiosqlite:////app/data/tracking.db

# systemd 裸机部署时改为:
# DATABASE_URL=sqlite+aiosqlite:////opt/zoom-monitor/data/tracking.db

# ── App ──────────────────────────────────────────────────────────────────────
API_PORT=8000
WEBHOOK_PORT=9000
MONITOR_INTERVAL=30
SECRET_KEY=

# ── LLM（可选，用于日报 AI 生成）─────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_REPORT_MODEL=deepseek-chat
