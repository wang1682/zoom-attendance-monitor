# ── Zoom Monitor 配置 ──────────────────────────────────────
# 复制为 .env 并填入真实值
# cp .env.example .env && chmod 600 .env

# Zoom API (Server-to-Server OAuth)
# 在 Zoom Marketplace → 你的 App → App Credentials 获取
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=

# 要监控的会议 ID
# PMI：Zoom 个人会议室 ID（Settings → PMI）
# Extra ID：逗号分隔的其他会议室
ZOOM_PMI_ID=
ZOOM_EXTRA_MEETING_IDS=

# Telegram Bot
# Token: @BotFather 创建 Bot 后获取
# Chat ID: @userinfobot 获取
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIVATE_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_GROUP_ENABLED=false

# Webhook 签名密钥（可选）
# Zoom Marketplace → Feature → Webhook → Secret Token
ZOOM_WEBHOOK_SECRET=

# 推送时段（北京时间）
PUSH_START_HOUR=7
PUSH_END_HOUR=23
SIGNIN_DEADLINE_HOUR=9

# 汇总/日报时段（北京时间）
SUMMARY_HOURS=16,23
DAILY_REPORT_HOUR=23
OVERTIME_MINUTES=120

# 监控间隔（秒）
MONITOR_INTERVAL=30

# API 安全密钥
SECRET_KEY=change-me-to-a-random-string

# LLM 日报（可选 — 需要 DeepSeek API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com  # 替换为你的 API Base URL
AI_REPORT_MODEL=deepseek-chat

# ── Docker 专用（无需修改） ──
DATABASE_URL=sqlite:////app/data/tracking.db
API_HOST=0.0.0.0
API_PORT=8000
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9000
